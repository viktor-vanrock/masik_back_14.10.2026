            "url": "{{baseUrl}}/external/v1/metrics"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const key = pm.environment.get('externalMetricsApiKey') || '';",
                  "if (!key) { throw new Error('Сначала создайте full-access API key'); }",
                  "const last = key.slice(-1);",
                  "pm.environment.set('tamperedExternalMetricsApiKey', key.slice(0, -1) + (last === 'A' ? 'B' : 'A'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
