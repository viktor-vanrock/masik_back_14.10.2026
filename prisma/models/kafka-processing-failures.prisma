enum KafkaProcessingFailureStatus {
  retrying
  resolved
  dead_lettered
}

model KafkaProcessingFailure {
  id String @id @default(uuid()) @db.Uuid

  /**
   * Физическая позиция однозначно идентифицирует входящую Kafka-запись.
   */
  topic     String @db.VarChar(249)
  partition Int
  offset    BigInt @db.BigInt

  messageKey String? @map("message_key") @db.VarChar(255)
  attempts   Int     @default(1)
  lastError  String  @map("last_error") @db.Text

  status KafkaProcessingFailureStatus @default(retrying)

  /**
   * eventId Outbox-события, которое доставит исходную запись в DLQ.
   */
  deadLetterEventId String? @unique @map("dead_letter_event_id") @db.Uuid

  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([topic, partition, offset])
  @@index([status, updatedAt])
  @@map("kafka_processing_failures")
}
