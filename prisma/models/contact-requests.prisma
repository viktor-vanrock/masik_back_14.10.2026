model ContactRequest {
  id             String       @id @default(uuid()) @db.Uuid
  publicNumber   String       @unique @map("public_number") @db.VarChar(48)
  chatId         String       @map("chat_id") @db.Uuid
  chat           Conversation @relation(fields: [chatId], references: [id], onDelete: Restrict)
  materialSnapshot Json?      @map("material_snapshot") @db.JsonB
  requestOwnerId String?      @map("request_owner_id") @db.VarChar(160)
  idempotencyKey String?      @map("idempotency_key") @db.Uuid
  requestHash    String?      @map("request_hash") @db.VarChar(64)
  fullName       String       @map("full_name") @db.VarChar(100)
  email          String       @db.VarChar(254)
  consent        Boolean
  consentAt      DateTime     @default(now()) @map("consent_at") @db.Timestamptz(6)
  consentVersion String       @map("consent_version") @db.VarChar(80)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([chatId])
  @@unique([requestOwnerId, idempotencyKey])
  @@map("contact_requests")
}
