// ── Removed enums (now admin-editable dictionaries, see Dict* models below) ──
// BenchmarkTaskType, BenchmarkModality, BenchmarkModalityDirection,
// BenchmarkLanguage, BenchmarkDifficulty — removed in settings_dictionaries
// refactor. Their values live in taxonomy_* tables and are referenced by FK.

enum BenchmarkValidationStatus {
  validation
  published
  rejected
}

// ── Dictionary tables (admin-editable taxonomy) ─────────────────────────────
//
// Naming: model prefix `Dict`, table prefix `taxonomy_`.
//
// Case-insensitive uniqueness of `name` / `nameEn` is enforced by a functional
// unique index on `lower(name)` / `lower(name_en)` added in the migration SQL
// (Prisma 7 schema cannot express functional indexes). The plain `@@unique`
// declarations below give Prisma a typed `findUnique` key and are kept as a
// regression net for exact-case duplicates. For child dictionaries the
// functional index is scoped by `(parent_id, lower(...))`.

model DictMacroGroup {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @db.VarChar(500)
  nameEn        String  @map("name_en") @db.VarChar(500)
  description   String? @db.Text
  descriptionEn String? @map("description_en") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  subGroups DictSubGroup[]

  @@unique([name])
  @@unique([nameEn])
  @@index([deletedAt])
  @@map("taxonomy_macro_groups")
}

model DictSubGroup {
  id           String @id @default(uuid()) @db.Uuid
  macroGroupId String @map("macro_group_id") @db.Uuid

  name          String  @db.VarChar(500)
  nameEn        String  @map("name_en") @db.VarChar(500)
  description   String? @db.Text
  descriptionEn String? @map("description_en") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  macroGroup DictMacroGroup @relation(fields: [macroGroupId], references: [id], onDelete: Restrict)

  @@unique([macroGroupId, name])
  @@unique([macroGroupId, nameEn])
  @@index([macroGroupId])
  @@index([deletedAt])
  @@map("taxonomy_sub_groups")
}

