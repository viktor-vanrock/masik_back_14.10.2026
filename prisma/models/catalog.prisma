model CatalogEntry {
  id String @id @default(uuid()) @db.Uuid

  // Identifier of the Test owned by benchmark-service. This is deliberately a
  // scalar reference: Catalog moderation must not depend on a local Test row or
  // on a cross-service foreign key.
  testId String @unique @map("test_id") @db.VarChar(160)

  authorId String? @map("author_id") @db.Uuid
  author   User?   @relation("CatalogEntryAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  sourceConversationId String?       @unique @map("source_conversation_id") @db.Uuid
  sourceConversation   Conversation? @relation("CatalogEntrySourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)

  status          BenchmarkValidationStatus @default(validation)
  rejectionReason String?                   @map("rejection_reason") @db.Text

  reviewedById String? @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?   @relation("CatalogEntryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, archivedAt])
  @@index([authorId, status])
  @@index([reviewedById])
  @@map("catalog_entries")
}

/**
 * Материализованный текст карточки и его embedding для semantic retrieval.
 * Поле embedding обрабатывается raw SQL: Prisma пока не предоставляет
 * типизированные vector operators pgvector.
 */
model BenchmarkSearchDocument {
  benchmarkTestId String @id @map("benchmark_test_id") @db.VarChar(160)

  documentText String @map("document_text") @db.Text
  contentHash  String @map("content_hash") @db.VarChar(64)

  embedding           Unsupported("vector")
  embeddingSpecId     String                @map("embedding_spec_id") @db.VarChar(255)
  embeddingDimensions Int                   @map("embedding_dimensions")

  sourceUpdatedAt DateTime @map("source_updated_at") @db.Timestamptz(6)
  embeddedAt      DateTime @default(now()) @map("embedded_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([embeddingSpecId, embeddingDimensions])
  @@index([sourceUpdatedAt])
  @@map("benchmark_search_documents")
}
