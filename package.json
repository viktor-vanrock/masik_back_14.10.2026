{
  "name": "benchmark-catalog-back",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "postinstall": "node scripts/patch-kafkajs.cjs && prisma generate",
    "prestart": "node scripts/patch-kafkajs.cjs",
    "prestart:dev": "node scripts/patch-kafkajs.cjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "typecheck:src": "tsc --noEmit --project tsconfig.json",
    "typecheck:test": "tsc --noEmit --project test/tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node scripts/run-e2e-tests.js",
    "test:e2e:jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "test:all": "npm run test:unit && npm run test:e2e",
    "verify": "npm run lint && npm run typecheck && npm run test:all && npm run build",
    "prebuild": "node scripts/patch-kafkajs.cjs && prisma generate",
    "search:reindex": "ts-node -r tsconfig-paths/register -r ./scripts/register.js src/search-reindex.ts",
    "search:reindex:prod": "node dist/search-reindex",
    "benchmark:topology:smoke": "ts-node --files -r tsconfig-paths/register -r ./scripts/register.js scripts/benchmark-topology-smoke.ts",
    "seed:catalog": "ts-node --files -r tsconfig-paths/register -r ./scripts/register.js scripts/seed-benchmark-catalog.ts",
    "seed:catalog:test": "node --test -r ts-node/register -r tsconfig-paths/register -r ./scripts/register.js scripts/seed-benchmark-catalog.test.cjs",
    "mock:ml": "ts-node --files -r tsconfig-paths/register -r ./scripts/register.js scripts/mock-model-server.ts",
    "recommendations:smoke": "ts-node --files -r tsconfig-paths/register -r ./scripts/register.js scripts/recommendation-workflow-smoke.ts",
    "docker:up": "docker compose --env-file local/.env -f local/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file local/.env -f local/docker-compose.yml down",
    "docker:logs": "docker compose --env-file local/.env -f local/docker-compose.yml logs -f db",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/websockets": "^11.1.24",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^0.7.2",
    "kafkajs": "^2.2.4",
    "ms": "^2.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.19.41",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^16.5.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.59.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.(t|j)s",
      "!**/main.(t|j)s",
      "!**/dist/**",
      "!**/node_modules/**"
    ],
    "coveragePathIgnorePatterns": [
      "/generated/",
      "/dto/",
      "\\.controller\\.ts$",
      "\\.module\\.ts$",
      "\\.provider\\.ts$",
      "\\.interface\\.ts$",
      "/types?\\.ts$",
      "/configs/",
      "/main\\.ts$"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 38,
        "functions": 31,
        "lines": 40,
        "statements": 41
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
