DB_NAME=benchmark_catalog
DB_USER=admin
DB_PWD=12345
DB_HOST=localhost
DB_PORT=5432

# Local development only. Do not add NODE_ENV=dev to Vault or deployment environments.
NODE_ENV=dev
JWT_ACCESS_SECRET=secret
JWT_REFRESH_SECRET=secret
JWT_ACCESS_EXPIRE=7d
JWT_REFRESH_EXPIRE=7d

# TRUSTED_ORIGINS=https://benchmark-catalog.dev.sberdevices.ru
TRUSTED_ORIGINS=

# false; never enable this by default, and it does not need to be added to Vault.
ORIGIN_TRUST_FORWARDED_HEADERS=false

# Enable only for first bootstrap / recovery, then turn off in Vault.
ADMIN_SEED_ENABLED=true
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin1234!@$%

DB_URL=postgresql://admin:12345@localhost:5432/benchmark_catalog

REDIS_PASSWORD=123456
REDIS_PORT=6379
REDIS_HOST=localhost

# Benchmark entities are owned by Benchmark Service. Catalog keeps only its
# local projections and exchanges durable commands/events through Kafka.
KAFKA_ENABLED=true
KAFKA_CLIENT_ID=benchmark-catalog
KAFKA_BROKERS=127.0.0.1:19092
# Local Redpanda is plaintext. For port 9094 or production, the paths below
# are defaults; set these variables only when Vault mounts files elsewhere.
# KAFKA_SSL_CA_FILE=/vault/secrets/kafka-ca.pem
# KAFKA_SSL_CERT_FILE=/vault/secrets/kafka-cert.pem
# KAFKA_SSL_KEY_FILE=/vault/secrets/kafka-key.pem
KAFKA_CONSUMER_GROUP_ID=benchmark-catalog-projection-v1
KAFKA_CONNECTION_TIMEOUT_MS=5000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_CONSUMER_RESTART_DELAY_MS=5000
KAFKA_CONSUMER_MAX_PROCESSING_ATTEMPTS=5
BENCHMARK_SERVICE_READ_MODE=projection
BENCHMARK_SERVICE_WRITE_MODE=remote

# Vault Transit for external API keys
VAULT_ADDR=http://127.0.0.1:8200
# Local development: set VAULT_TOKEN to the same value as VAULT_DEV_ROOT_TOKEN in local/.env.
# In Kubernetes leave VAULT_TOKEN empty and mount the token at VAULT_TOKEN_FILE instead.
VAULT_TOKEN=dev-only-root-token
VAULT_TOKEN_FILE=/vault/secrets/token
VAULT_NAMESPACE=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_HMAC_KEY=benchmark-catalog-external-api
VAULT_TIMEOUT_MS=3000

# Factory handles the conversational interviewer and generation. Its search
# tool calls Catalog; GigaChat embeddings and PostgreSQL retrieval run here.
AGENT_MODE=mock
# dev/prod: AGENT_MODE=ws
THIRD_PARTY_WS_URL=
THIRD_PARTY_API_KEY=
# Per backend process. Treat defaults as safety ceilings, not measured SLOs.
AGENT_MAX_ACTIVE_SESSIONS=200
AGENT_MAX_PENDING_MESSAGES_PER_SESSION=32
AGENT_MAX_BUFFERED_BYTES_PER_SESSION=1048576
AGENT_MAX_PAYLOAD_BYTES=1048576
AGENT_SESSION_IDLE_TIMEOUT_MS=1800000
AGENT_RECONNECT_INITIAL_DELAY_MS=500
AGENT_RECONNECT_MAX_DELAY_MS=15000
AGENT_RECONNECT_MAX_ATTEMPTS=8
AGENT_HEARTBEAT_INTERVAL_MS=25000
AGENT_HEARTBEAT_TIMEOUT_MS=10000

# Parallel GigaChat -> PostgreSQL FTS/pgvector searches per backend process.
RECOMMENDATION_MAX_CONCURRENT_EXECUTIONS=16

# This explicit mock is for local development/tests only; production rejects it.
# For a deployed dev/prod environment set gigachat (or leave the provider unset).
# The legacy openai-compatible value also resolves to GigaChat; it never calls
# the old EMBEDDING_URL. NODE_ENV=dev alone does not enable mock embeddings.
EMBEDDING_PROVIDER=mock

# Required for real GigaChat retrieval; provision in the Catalog Vault secret.
# BASE_URL is the API prefix; the client appends /embeddings.
# AUTH_URL is the exact OAuth endpoint. CREDENTIALS is the Base64 Basic payload,
# without the "Basic " prefix; do not use a temporary Bearer access token here.
GIGACHAT_BASE_URL=
GIGACHAT_AUTH_URL=
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_CORP

# The release pins Embeddings-2, 1024 dimensions, L2 normalization, UTF-8 chunks
# <=400 bytes and byte-weighted pooling; spec:
# gigachat:Embeddings-2:benchmark-test-document-v1:dim-1024:l2:chunk400b-mean-v1
# It also pins timeout=120000ms, retries=2, retry delay=250ms, candidates=20,
# batch=16. Legacy EMBEDDING_MODEL/SPEC_ID/DIMENSIONS/SOURCE_DIMENSIONS,
# EMBEDDING_URL/API_KEY/tuning and RETRIEVAL_INSTRUCTION do not change GigaChat.
# Query embedding budget=15000ms; OAuth is shared, with an independent timeout.
# Search SQL statement_timeout=3000ms (transaction-local), transaction=5000ms.
# Catalog pg connection acquisition=1000ms; Prisma search maxWait=2000ms.
# RRF considers min(5*candidates, 500) per branch, then returns candidates=20.
# Reindex the existing Catalog search documents after upgrading, without reset
# or seed. See docs/deployment.md section 10; Benchmark Service data is preserved.

# Keep PostgreSQL retrieval ranking. No separate reranker endpoint is used.
# An existing value "reranker" is treated as the legacy alias for "retrieval";
# obsolete RERANKER_* settings can be removed from Catalog Vault.
# Optional "factory" retains selection from Catalog-owned candidates.
RECOMMENDATION_SELECTION_PROVIDER=retrieval
FACTORY_SELECTION_URL=
FACTORY_SELECTION_TIMEOUT_MS=195000
